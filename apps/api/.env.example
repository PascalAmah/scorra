# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Redis
REDIS_URL=redis://:scorra_redis_secret@localhost:6379  # matches docker-compose redis password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AI...
EVALUATION_AI_MODEL=gpt-4o
EVALUATION_AI_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022
EVALUATION_AI_MODEL_GROQ=openai/gpt-oss-120b
EVALUATION_AI_MODEL_GEMINI=gemini-2.0-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Storage
STORAGE_DRIVER=supabase
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
SUPABASE_STORAGE_BUCKET=uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (SMTP) — leave blank to disable delivery; invite URLs will be logged instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@scorra.dev




